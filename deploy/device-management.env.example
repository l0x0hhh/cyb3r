NODE_ENV=production
PORT=3000
ADMIN_PASSWORD=请替换为至少16位的随机密码
APP_BASE_URL=https://cyb3r.art
TRUST_PROXY=true
DATA_DIR=/var/lib/device-management/data
UPLOAD_DIR=/var/lib/device-management/uploads
QR_DIR=/var/lib/device-management/qrcodes
# 用 `openssl rand -base64 32` 生成；后台保存的 SMTP 密码/授权码会使用此密钥加密。
EMAIL_CONFIG_KEY=
