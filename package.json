{
  "name": "campus-equipment-and-supplies-management-system",
  "version": "1.0.0",
  "description": "学院设备与物资管理系统：独立业务、统一后台、免账户借还",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "migrate:images": "node scripts/migrate-image-variants.js",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.js",
    "test": "node --test"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "motion-v": "2.4.2",
    "multer": "2.5.0",
    "qrcode": "^1.5.0",
    "sharp": "0.35.5",
    "vue": "3.5.44"
  },
  "keywords": [
    "device",
    "management",
    "h5"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ltyyyyy1017/Campus-Equipment-and-Supplies-Management-System.git"
  },
  "homepage": "https://github.com/ltyyyyy1017/Campus-Equipment-and-Supplies-Management-System#readme"
}
