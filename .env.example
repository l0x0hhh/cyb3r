# Example only. Node does not load this file automatically.
# Use node --env-file=.env server.js or an environment manager.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
# Set ADMIN_PASSWORD_HASH to the output of: node scripts/create-admin-hash.cjs
ADMIN_PASSWORD_HASH=
# For production, generate a fresh value with: openssl rand -base64 32
EMAIL_CONFIG_KEY=
TRUST_PROXY=false
MATERIALS_DEMO=false
MATERIALS_PORTAL=false
# Optional public filing number, embedded by npm run build.
VITE_ICP_NUMBER=
